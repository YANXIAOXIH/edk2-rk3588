&tsadc {
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	status = "okay";
};

&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	phy-supply = <&vcc5v0_usb>;
	status = "okay";
};

&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	phy-supply = <&vcc5v0_usb>;
	status = "okay";
};

/* USB3/DP combo PHY of the Type-C port, DP altmode is enabled here */
&usbdp_phy0 {
	mode-switch;
	orientation-switch;
	pinctrl-names = "default";
	pinctrl-0 = <&typec0_sbu_dc>;
	sbu1-dc-gpios = <&gpio1 RK_PA0 GPIO_ACTIVE_HIGH>;
	sbu2-dc-gpios = <&gpio1 RK_PA1 GPIO_ACTIVE_HIGH>;
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * Endpoint layout follows the rockchip,rk3588-usbdp-phy binding:
		 *   port@0 - PHY output for USB (SuperSpeed towards the connector)
		 *   port@1 - input from the USB controller
		 *   port@2 - input from the DisplayPort controller
		 *   port@3 - PHY output for the DP auxiliary channel (SBU)
		 */
		usbdp_phy0_ss_out: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_ss>;
		};

		usbdp_phy0_ss_in: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&usb_host0_xhci_ss>;
		};

		usbdp_phy0_dp_in: endpoint@2 {
			reg = <2>;
			remote-endpoint = <&dp0_out_con>;
		};

		usbdp_phy0_dp_out: endpoint@3 {
			reg = <3>;
			remote-endpoint = <&usbc0_sbu>;
		};
	};
};

/* USB3/DP combo PHY of the first USB 3.0 type-A port */
&usbdp_phy1 {
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

/* USB 3.0 OTG, Type-C port */
&usb_host0_xhci {
	usb-role-switch;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			usb_host0_xhci_drd_sw: endpoint {
				remote-endpoint = <&usbc0_hs>;
			};
		};

		port@1 {
			reg = <1>;
			usb_host0_xhci_ss: endpoint {
				remote-endpoint = <&usbdp_phy0_ss_in>;
			};
		};
	};
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

/* USB 3.0 type-A port 1, usbdp_phy1 */
&usb_host1_xhci {
	dr_mode = "host";
	status = "okay";
};

/* USB 3.0 type-A port 2, combphy2_psu */
&usb_host2_xhci {
	status = "okay";
};

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

/* VP1 drives HDMI1 */
&vp1 {
	vp1_out_hdmi1: endpoint@ROCKCHIP_VOP2_EP_HDMI1 {
		reg = <ROCKCHIP_VOP2_EP_HDMI1>;
		remote-endpoint = <&hdmi1_in_vp1>;
	};
};

/*
 * VP2 drives DisplayPort 0. Running dclk_vp2 from V0PLL allows arbitrary
 * pixel clocks for the DP link, the GPLL only provides standard rates.
 */
&vp2 {
	assigned-clocks = <&cru DCLK_VOP2_SRC>;
	assigned-clock-parents = <&cru PLL_V0PLL>;

	vp2_out_dp0: endpoint@a {
		reg = <ROCKCHIP_VOP2_EP_DP0>;
		remote-endpoint = <&dp0_in_vp2>;
	};
};

/*
 * Hardware that is present on the carrier board but not described here:
 *
 *  - MIPI DSI0 panel connector J25 (sheet 15): needs the panel model, its
 *    timings, the backlight PWM channel (LCD0_BL_PWM) and the touch
 *    controller, none of which are documented for this board revision.
 *  - IR remote control: the carrier uses the Rockchip BSP "remotectl"
 *    PWM decoder, mainline can only use the plain gpio-ir-receiver
 *    driver, so the BSP key table (ir_key_*) does not apply.  See the
 *    ir-receiver node above.
 *  - User_Key button (sheet 13) arrives on MXM connector J4 pin 13.  The
 *    carrier renames that net, so the SoM side signal name (and with it
 *    the GPIO) is not in the carrier board schematic and cannot be
 *    derived from it, so no gpio-keys node can be written yet.  Once the
 *    SoM pin is known add, next to the adc-keys node:
 *
 *	gpio-keys {
 *		compatible = "gpio-keys";
 *		pinctrl-names = "default";
 *		pinctrl-0 = <&user_key_pin>;
 *
 *		button-user {
 *			label = "User Key";
 *			linux,code = <BTN_1>;
 *			gpios = <&gpioX RK_PC0 GPIO_ACTIVE_LOW>;
 *			debounce-interval = <50>;
 *			wakeup-source;
 *		};
 *	};
 *
 *    with the matching user_key_pin entry in &pinctrl. Note that BTN_1 or
 *    KEY_MENU/KEY_VENDOR are valid codes while "KEY_USER" does not exist.
 *  - The MXM connector exposes an analog audio path (I2C7_M0_CODEC,
 *    I2S0_*, HP_PLUG_IN_DET, EARPHONE_CTL on sheet 16), but this carrier
 *    board does not route it to any jack, so I2C7/I2S0 stay disabled. If a
 *    SoM revision with the codec fitted is used, port the ES8388 node from
 *    the vendor 6.1 device tree.
 *
 *  - HDMI0, EDP0 and the second Type-C (TYPEC1) are not routed to a
 *    connector on this carrier board.
 */

